{
  "name": "devden",
  "version": "0.1.0",
  "type": "module",
  "description": "Web workbench for local coding agents: pi, Claude Code, Grok, and Codex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aishwarya-sureshV/devden.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "devden": "bin/devden"
  },
  "files": [
    "bin/devden",
    "bin/lib",
    "server",
    "scripts/deploy.mjs",
    "scripts/supervise.mjs",
    "dist"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/supervise.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "node server/index.js",
    "start": "node scripts/supervise.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/ src/lib/",
    "app": "npm start --prefix electron",
    "app:dist": "npm run dist --prefix electron",
    "check:grok": "node server/grok-selfcheck.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "codemirror": "^6.0.2",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
